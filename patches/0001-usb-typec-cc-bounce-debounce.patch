diff --git a/drivers/power/supply/qcom/smb-lib.c b/drivers/power/supply/qcom/smb-lib.c
index 1b1c467..9d10e2a 100644
--- a/drivers/power/supply/qcom/smb-lib.c
+++ b/drivers/power/supply/qcom/smb-lib.c
@@ -5942,9 +5942,17 @@ static void smblib_dc_input_current_work(struct work_struct *work)
 }
 #endif
 
+#define TYPEC_CC_POLL_MS		50
+#define TYPEC_CC_STABLE_MS		300
+#define TYPEC_CC_MAX_WAIT_MS	2000
+
 void smblib_usb_typec_change(struct smb_charger *chg)
 {
 	int rc;
+#if defined(CONFIG_MACH_XIAOMI_SDM845)
+	int waited;
+	int typec_mode, new_mode;
+#endif
 
 	rc = smblib_multibyte_read(chg, TYPE_C_STATUS_1_REG,
 							chg->typec_status, 5);
@@ -5953,6 +5961,47 @@ void smblib_usb_typec_change(struct smb_charger *chg)
 		return;
 	}
 
+#if defined(CONFIG_MACH_XIAOMI_SDM845)
+	/*
+	 * Debounce the Type-C CC bounce storms beryllium shows around a plug
+	 * or an unplug.  A single fixed delay is not enough: the port really
+	 * does oscillate, roughly once a second, between attached and
+	 * detached for a couple of seconds.  Reporting any single step of
+	 * that oscillation is actively harmful, because handling a transient
+	 * state writes Type-C registers (DPDM request, power role) which
+	 * provokes the next transition, so acting on the bounce feeds it.
+	 *
+	 * So require the state to be quiet for a full stable window, polling
+	 * in between: a genuine transition is reported after
+	 * TYPEC_CC_STABLE_MS just as before, while a bounce only gets through
+	 * once it has actually settled.  A port that never settles within
+	 * TYPEC_CC_MAX_WAIT_MS is ignored entirely - the interrupt raised by
+	 * the last transition still sees a quiet port and reports it then,
+	 * so the settled state is never lost.
+	 */
+	typec_mode = smblib_get_prop_typec_mode(chg);
+	waited = 0;
+	while (waited < TYPEC_CC_MAX_WAIT_MS) {
+		msleep(TYPEC_CC_POLL_MS);
+		waited += TYPEC_CC_POLL_MS;
+		rc = smblib_multibyte_read(chg, TYPE_C_STATUS_1_REG,
+								chg->typec_status, 5);
+		if (rc < 0)
+			return;
+		new_mode = smblib_get_prop_typec_mode(chg);
+		if (new_mode != typec_mode) {
+			/* still moving, restart the stability window */
+			typec_mode = new_mode;
+			waited = 0;
+			continue;
+		}
+		if (waited >= TYPEC_CC_STABLE_MS)
+			break;
+	}
+	if (waited < TYPEC_CC_STABLE_MS)
+		return;
+#endif
+
 	smblib_handle_typec_cc_state_change(chg);
 
 	if (chg->typec_status[3] & TYPEC_VBUS_ERROR_STATUS_BIT)
