diff --git a/drivers/power/supply/qcom/smb-lib.c b/drivers/power/supply/qcom/smb-lib.c
index 1b1c467..833a13e 100644
--- a/drivers/power/supply/qcom/smb-lib.c
+++ b/drivers/power/supply/qcom/smb-lib.c
@@ -5942,9 +5942,14 @@ static void smblib_dc_input_current_work(struct work_struct *work)
 }
 #endif
 
+#define TYPEC_CC_BOUNCE_DEBOUNCE_MS	300
+
 void smblib_usb_typec_change(struct smb_charger *chg)
 {
 	int rc;
+#if defined(CONFIG_MACH_XIAOMI_SDM845)
+	int typec_mode;
+#endif
 
 	rc = smblib_multibyte_read(chg, TYPE_C_STATUS_1_REG,
 							chg->typec_status, 5);
@@ -5953,6 +5958,27 @@ void smblib_usb_typec_change(struct smb_charger *chg)
 		return;
 	}
 
+#if defined(CONFIG_MACH_XIAOMI_SDM845)
+	/*
+	 * Debounce the Type-C CC bounce storms beryllium shows around a plug
+	 * or an unplug: the port flaps between attached and detached a few
+	 * times per second and every flap reaches the USB stack, which tears
+	 * the gadget down and leaves USB dead.
+	 *
+	 * Only report a state that has been quiet for a whole debounce
+	 * window.  Dropping a busy window on purpose: handling a transient
+	 * state writes Type-C registers (DPDM request, power role), which
+	 * raises further CC interrupts, so acting on a flapping port feeds
+	 * itself.  Suppressing the transients is what lets it settle.
+	 */
+	typec_mode = smblib_get_prop_typec_mode(chg);
+	msleep(TYPEC_CC_BOUNCE_DEBOUNCE_MS);
+	rc = smblib_multibyte_read(chg, TYPE_C_STATUS_1_REG,
+							chg->typec_status, 5);
+	if (rc < 0 || smblib_get_prop_typec_mode(chg) != typec_mode)
+		return;
+#endif
+
 	smblib_handle_typec_cc_state_change(chg);
 
 	if (chg->typec_status[3] & TYPEC_VBUS_ERROR_STATUS_BIT)
